// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"active_pane_modifiers": {
		"inactive_opacity": 0.85
	},
	"agent_servers": {
		"github-copilot": {
			"type": "registry"
		}
	},
	"auto_signature_help": true,
	"auto_update": true,
	"auto_update_extensions": {
		"vue": false
	},
	"buffer_font_fallbacks": [
		"Fluent Emoji Color",
		"Fluent Emoji Flat",
		"OpenMoji"
	],
	"buffer_font_family": "Maple Mono NF CN",
	"buffer_font_size": 18,
	"calls": {
		"mute_on_join": true
	},
	"code_lens": "on",
	"colorize_brackets": true,

	"debugger": {
		"dock": "bottom",
		"stepping_granularity": "statement"
	},
	"diagnostics_max_severity": null,
	"diff_view_style": "split",
	"document_folding_ranges": "on",
	"file_types": {
		"Editorconfig": [
			"*.editorconfig"
		],
		"Hyprlang": [
			"hypr[!land]*{,.conf}"
		]
		// "Hyprland Config":["hyprland.conf"],
	},
	"format_on_save": "on",
	"git_panel": {
		"collapse_untracked_diff": true,
		"dock": "left",
		"scrollbar": {
			"show": "system"
		},
		"sort_by":"path",
		"status_style": "label_color",
		"tree_view": true
	},
	"hard_tabs": true,
	"icon_theme": {
		"dark": "Catppuccin Mocha",
		"light": "Catppuccin Latte",
		"mode": "system"
	},
	"indent_guides": {
		"background_coloring": "indent_aware",
		"coloring": "indent_aware"
	},
	"inlay_hints": {
		"enabled": false,
		"show_background": true,
		"toggle_on_modifiers_press": {
			"alt": true,
			"control": true
		}
	},
	"languages": {
		"HTML": {
			"formatter": {
				"language_server": {
					"name": "superhtml"
				}
			},
			"jsx_tag_auto_close": {
				"enabled": false
			},
			"language_servers": [
				"vscode-html-language-server",
				"superhtml"
			],
			"linked_edits": true,
			"use_autoclose": true
		},
		"JavaScript": {
			"language_servers": [
				"vtsls",
				"eslint",
				"!typescript-language-server"
			]
		},
		"TSX": {
			"language_servers": [
				"vtsls",
				"eslint",
				"!typescript-language-server"
			]
		},
		"TypeScript": {
			"language_servers": [
				"vtsls",
				"biome",
				"!typescript-language-server"
			]
		}
	},
	"prettier":{
		"allowed": false,
	},
	"linked_edits": true,
	"lsp": {
		"powershell-es": {
			"binary": {
				"arguments": [
					"-NoLogo",
					"-NoProfile",
					"-Command",
					" C:\\Users\\legor\\scoop\\apps\\powershelleditorservices\\current\\PowerShellEditorServices\\Start-EditorServices.ps1",
					"-Stdio",
					"-SessionDetailsPath",
					"C:\\Users\\legor\\scoop\\apps\\powershelleditorservices\\current\\PowerShellEditorServices\\powershell-es.session.json"
				],
				"path": "pwsh.exe"
			}
		}
	},
	"minimap": {
		"current_line_highlight": "all",
		"display_in": "active_editor",
		"show": "auto",
		"thumb": "always",
		"thumb_border": "full"
	},
	"outline_panel": {
		"dock": "left"
	},
	// "use_system_window_tabs": true,
	"preview_tabs": {
		"enable_keep_preview_on_code_navigation": true,
		"enable_preview_from_file_finder": true
	},
	"redact_private_values": false,
	"restore_on_startup": "last_session",
	"scroll_beyond_last_line": "vertical_scroll_margin",
	"seed_search_query_from_cursor": "selection",
	"show_signature_help_after_edits": true,
	"show_whitespaces": "boundary",
	"status_bar": {
		"line_endings_button": true,
		"show_active_file": false
	},
	"sticky_scroll": {
		// disabled until the stuck line can be opaque with my transluscent themes
		"enabled": true
	},
	"tab_bar": {
		"show_pinned_tabs_in_separate_row": true
	},
	"tabs": {
		"close_position": "right",
		"file_icons": false,
		"git_status": true,
		"show_close_button": "hover",
		"show_diagnostics": "off"
	},
	"terminal": {
		// "font_size": 12
		"toolbar": {
			"breadcrumbs": true
		}
	},
	"theme": {
		"dark": "Catppuccin Mocha",
		"light": "Catppuccin Latte",
		"mode": "system"
	},
	"title_bar": {
		"button_layout": "platform_default",
		"show_branch_status_icon": true,
		"show_menus": false
	},
	"toolbar": {
		"code_actions": true
	},
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 20,
	"unnecessary_code_fade": 0.4000000059604645,
	"which_key": {
		"enabled": true
	}
}
