{{- if eq .chezmoi.os "windows" -}}
[credential "https://github.com"]
	helper =
	helper = !'{{ .chezmoi.homeDir | osClean | replace "\\" "\\\\" }}\\scoop\\apps\\gh\\current\\bin\\gh.exe' auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !'{{ .chezmoi.homeDir | osClean | replace "\\" "\\\\" }}\\scoop\\apps\\gh\\current\\bin\\gh.exe' auth git-credential
{{ end }}
