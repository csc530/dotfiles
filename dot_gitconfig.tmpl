# diff so fancy
[core]
	pager = diff-so-fancy | less --tabs=4 -RF
	{{  if eq .chezmoi.os "windows" -}} sshCommand = "C:/Windows/System32/OpenSSH/ssh.exe" {{ end }}

[interactive]
	diffFilter = diff-so-fancy --patch

[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse

[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = {{ .git.opPath | replace "\\" "\\\\" }}
[status]
	submoduleSummary = 1
[submodule]
	recurse = true
[push]
	recurseSubmodules = check


[credential "https://github.com"]
	helper =
	helper = !{{- .git.ghPath | replace "\\" "\\\\" }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{- .git.ghPath | replace "\\" "\\\\" }} auth git-credential
