# ==============================================================================
# 1. BASIC DECLARATIONS & QUOTING
# ==============================================================================
# Unquoted values (best for simple strings, booleans, and numbers)
APP_NAME=MyAwesomeApp
APP_PORT=3000
DEBUG_MODE=true

# Single quotes (typically treats everything inside literally, preventing expansion)
DB_PASSWORD='super$ecret!Password#123'

# Double quotes (allows for spaces and variable expansion)
WELCOME_MESSAGE="Welcome to the application!"

# ==============================================================================
# 2. VARIABLE EXPANSION & REFERENCING
# ==============================================================================
# Referencing previously declared variables (No curly braces)
LOCAL_URL=http://localhost:$APP_PORT

# Referencing previously declared variables (With curly braces - PREFERRED)
API_ENDPOINT=https://api.domain.com/v1
AUTH_URL=${API_ENDPOINT}/auth

# Combining multiple previously declared variables
FULL_DB_CONNECTION="postgresql://admin:${DB_PASSWORD}@localhost:5432/mydb"

# Referencing existing OS/system environment variables (like $USER or $HOME)
USER_UPLOADS_DIR="${HOME}/app/uploads"
CURRENT_USER_GREETING="Hello, ${USER}!"

# Default fallbacks (supported by libraries like dotenv-expand or bash)
# If SYSTEM_THEME is not set on the machine, it defaults to 'dark'
THEME=${SYSTEM_THEME:-dark}

# ==============================================================================
# 3. SPACES & COMMENTS
# ==============================================================================
# Standard full-line comment
MAINTENANCE_MODE=false

# Inline comments (Behavior varies by parser; usually safe if the value is simple)
MAX_RETRIES=5 # Number of times to retry a failed request

# Handling spaces inside values requires quotes
LONG_DESCRIPTION="This is a value that contains multiple spaces safely."

# NOTE: Spaces around the equals sign are generally BAD PRACTICE in .env files
# because native bash 'source' will fail, but some dotenv libraries tolerate it.
TOLERANT_VAR = "Some parsers accept this"

# ==============================================================================
# 4. ADVANCED SYNTAX & EDGE CASES
# ==============================================================================
# Escaping the dollar sign to PREVENT variable expansion
COST_STRING="The total cost is \$500.00"

# Escaping internal quotes (useful for JSON strings)
FEATURE_FLAGS="{\"new_ui\": true, \"beta_testing\": false}"

# Multi-line strings (supported by modern dotenv libraries)
# Useful for storing certificates or private keys
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...
...some fake base64 string...
-----END RSA PRIVATE KEY-----"

# ==============================================================================
# 5. EXPORT SYNTAX (BASH COMPATIBILITY)
# ==============================================================================
# Some teams prefix with 'export' so the file can be directly sourced in a terminal:
# e.g., `source .env`
export NODE_ENV=production
export AWS_REGION=us-east-1
