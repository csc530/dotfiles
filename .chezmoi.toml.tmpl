
interactive = true
progress = true

update.recurseSubmodules = false

[diff]
    pager = "delta"
    # pager = "diff-so-fancy"

[data]


[data.git]
    ghPath = {{ if eq .chezmoi.os "linux" -}}
            /usr/bin/gh
        {{ else if eq .chezmoi.os "windows" -}}
            '"{{ .chezmoi.homeDir }}/scoop/apps/gh/current/bin/gh.exe"'
       {{ else if eq .chezmoi.os "darwin" -}}
            /opt/homebrew/bin/gh
        {{- end }}
    opPath = {{ if eq .chezmoi.os "linux" -}}
            /opt/1Password/op-ssh-sign
        {{ else if eq .chezmoi.os "windows" -}}
           "C:/Program Files/1Password/app/8/op-ssh-sign.exe"
        {{ else if eq .chezmoi.os "darwin" -}}
            /Applications/1Password.app/Contents/MacOS/op-ssh-sign
        {{- end }}
