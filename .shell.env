# please do not have any spaces between `=` for maximum compatibility between shells
# thank you 😀

## XDG-tings: https://wiki.archlinux.org/title/XDG_Base_Directory
XDG_CONFIG_HOME=$HOME/.config
XDG_CACHE_HOME=$HOME/.cache
XDG_DATA_HOME=$HOME/.local/share
XDG_STATE_HOME=$HOME/.local/state
# XDG_RUNTIME_DIR=$HOME/

## terminal
POSH_THEME=~/.config/oh-my-posh/themes/theme.omp.json

## defaults and openers (handlers)
VISUAL="zeditor --wait --foreground"
EDITOR=micro
TERMINAL=kitty
