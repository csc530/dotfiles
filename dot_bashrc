
# If not running interactively, don't do anything
[[ $- != *i* ]] && return

PS1='[\u@\h \W]\$ '

source ~/.bash_aliases
shellname=$(basename $SHELL)
eval "$(oh-my-posh init $shellname --print --config ~/.config/oh-my-posh/themes/theme.omp.json)"
source <(carapace _carapace $shellname)
source <(zoxide init $shellname)
eval "$(direnv hook $shellname)"
eval "$(mise activate $shellname)"

pokemon=$(pokeget random --hide-name)

set -a # automatically export all variables
source $HOME/.shell.env
set +a

cookie=("fortune" "misfortune --all" "kotofetch --source=true")
fetch=(pfetch macchina fastfetch countryfetch cpufetch)

${fetch[$(( RANDOM % ${#fetch[@]} ))]}
${cookie[$(( $RANDOM % ${#cookie[@]} ))]}

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize
